NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pricehunter:pricehunter@localhost:5432/pricehunter?schema=public
POSTGRES_PASSWORD=replace_with_a_strong_password

# Создайте бота в MAX для бизнеса и вставьте токен. Не публикуйте этот файл с секретами.
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru

# webhook — для production; polling — только для локальной разработки.
MAX_MODE=webhook
MAX_WEBHOOK_URL=https://your-domain.example/webhook
MAX_WEBHOOK_SECRET=replace_with_random_secret_at_least_16_chars
# Включите на один deploy для первичной регистрации, затем снова установите false.
AUTO_REGISTER_WEBHOOK=false

TRIAL_DAYS=30
ALERT_CHECK_INTERVAL_MS=900000
SOURCE_TIMEOUT_MS=5000

# DemoSource оставляйте включённым только для демонстрации. В production используйте false.
ENABLE_DEMO_SOURCE=true

# Только полученные законным способом открытые/партнёрские YML-ленты.
# Пример: [{"name":"Магазин","url":"https://shop.example/catalog.yml"}]
YML_FEEDS_JSON=[]
YML_FEED_CACHE_TTL_MS=300000
YML_FEED_MAX_BYTES=25000000
YML_SOURCE_MAX_OFFERS=200

LOG_LEVEL=info
RUN_WORKER=true
